# ── EcoQuery Environment Variables ─────────────────────────────────────────
# Copy this file to `.env` at the REPOSITORY ROOT and fill in your values.
#     cp .env.example .env
#
# NOTE: backend/main.py loads ../.env, so the file belongs at the repo root —
# NOT inside backend/. Never commit the real `.env`.

# ── Required ───────────────────────────────────────────────────────────────

# OpenRouter API Key (free models with :free suffix)
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here

# Failover providers (optional — tried only when OpenRouter has no usable key)
GROK_API_KEY=
GOOGLE_API_KEY=

# JWT Secret for user session tokens
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is generated at startup (invalidates sessions on restart)
# Must be >= 32 characters in production (Render enforces this).
JWT_SECRET=

# Fernet key material for encrypting provider credentials at rest.
# Generate a high-entropy value and store it in Render secrets.
# Falls back to JWT_SECRET when unset, but production requires its own value.
KEY_ENCRYPTION_KEY=

# MongoDB connection string
# Get a free cluster at https://www.mongodb.com/atlas
MONGODB_URL=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/ecoquery

# Required in production for distributed rate limiting.
REDIS_URL=

# Set true only when audit users explicitly need raw prompt text retained.
STORE_QUERY_TEXT=false

# Optional comma-separated exact webhook host allowlist for egress control.
WEBHOOK_EGRESS_ALLOWLIST=

# ── CORS ───────────────────────────────────────────────────────────────────

# CORS allowed origins (comma-separated exact origins).
# There is deliberately no wildcard/suffix matching: only origins listed here
# may make credentialed requests.
# Default: http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Chat access policy — decided per endpoint, because they have different
# callers. Anonymous requests on either are bounded by the stricter
# unauthenticated /api/chat* rate-limit bucket.

# POST /api/chat — the documented Bearer-token API surface. No frontend caller
# uses it anonymously, so it defaults to locked (false).
ALLOW_ANONYMOUS_CHAT=false

# POST /api/chat/stream — powers the public homepage demo, which posts with no
# auth header. Defaults to open (true); set false to require login there too.
ALLOW_ANONYMOUS_CHAT_STREAM=true

# ── Optional ───────────────────────────────────────────────────────────────

# Electricity Maps API Key for real-time carbon intensity data
# Free tier: https://www.electricitymaps.com/
# Without this the app falls back to static IEA regional baselines.
ELECTRICITY_MAPS_API_KEY=

# Google OAuth credentials (for Sign in with Google)
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Brevo (Sendinblue) API Key for transactional emails
# Get one at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
FROM_EMAIL=your-verified-email@domain.com
FROM_NAME=EcoQuery

# Frontend origin used in emailed links
FRONTEND_URL=http://localhost:5173

# Exposes /docs and /openapi.json when set to true
ENABLE_API_DOCS=false

# Reported by GET /api/health so you can confirm a deploy actually picked up
# new code (pair it with `started_at`/`uptime_s`, which show the restart).
# Set it in the host environment to the git short SHA; defaults to "dev".
APP_VERSION=dev

# ── Server config ──────────────────────────────────────────────────────────
# Render supplies PORT at runtime; these are for local runs only.
HOST=0.0.0.0
PORT=8000
