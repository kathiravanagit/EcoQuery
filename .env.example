# OpenAI API Key (required for real LLM calls)
OPENAI_API_KEY=sk-your-key-here

# Electricity Maps API Key (required for real carbon intensity data)
# Get a free key at https://www.electricitymaps.com/
ELECTRICITY_MAPS_API_KEY=your-electricity-maps-key-here

# MongoDB connection string (required for verification ledger)
# Default: mongodb://localhost:27017/eco_query
MONGODB_URL=mongodb://localhost:27017/ecoquery

# FastAPI server config
HOST=0.0.0.0
PORT=8000
