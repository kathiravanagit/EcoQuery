# ── EcoQuery Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in your values.
#     cp .env.example .env

# ── Required ───────────────────────────────────────────────────────────────

# OpenRouter API Key (free models with :free suffix)
# Get one at https://openrouter.ai/keys
OPENAI_API_KEY=sk-or-your-key-here

# JWT Secret for user session tokens
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is generated at startup (invalidates sessions on restart)
JWT_SECRET=

# MongoDB connection string
# Get a free cluster at https://www.mongodb.com/atlas
MONGODB_URL=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/ecoquery

# ── Optional ───────────────────────────────────────────────────────────────

# Self-hosted Ollama VPS (real region pinning, lowest carbon)
# Supports multiple VPS instances across green regions for automatic routing.
# Format: http://ip:port:region,http://ip:port:region,...
# Proxy auto-routes to the greenest VPS based on real-time carbon intensity.
# Example: http://123.45.67.89:11434:eu-north-1,http://98.76.54.32:11434:eu-west-3
OLLAMA_ENDPOINTS=

# Single VPS fallback (used if OLLAMA_ENDPOINTS is empty)
OLLAMA_BASE_URL=
OLLAMA_REGION=eu-north-1

# Electricity Maps API Key for real-time carbon intensity data
# Free tier: https://www.electricitymaps.com/
ELECTRICITY_MAPS_API_KEY=

# CORS allowed origins (comma-separated)
# Default: http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google OAuth credentials (for Sign in with Google)
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# SMTP credentials for password reset emails
# Use SendGrid, Mailgun, or any SMTP provider
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Resend API Key (recommended — free tier: 100 emails/day)
# Get one at https://resend.com/api-keys
RESEND_API_KEY=
FROM_EMAIL=noreply@ecoquery.app

# Frontend URL for email links
FRONTEND_URL=https://eco2query.vercel.app

# Server config
HOST=0.0.0.0
PORT=8000
